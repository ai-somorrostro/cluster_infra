# Proxmox API credentials for scripts run outside the cluster nodes (WSL, provisioner, containers).
# cp .env.example .env   — .env is gitignored, never commit it.
# Token: Datacenter > Permissions > API Tokens, with "Privilege Separation" unchecked.
PROXMOX_API_URL=https://192.168.136.238:8006/api2/json
PROXMOX_API_TOKEN_ID=root@pam!infra
PROXMOX_API_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Proxmox MCP server token (only for reference; the MCP reads it from mcp/proxmox/config.json).
MCP_PROXMOX_TOKEN_ID=root@pam!mcp-token
MCP_PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: Markdown note that vm/vm_inventory.sh updates when run without --out.
# INVENTORY_OUT=/mnt/c/Users/<you>/Documents/Vault/clusteria/Inventario.md
