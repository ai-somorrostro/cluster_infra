#!/bin/bash

# vm_dhcp_renew - Renueva la IP de VMs usando qemu-guest-agent

set -e

if [ $# -lt 1 ]; then
    echo "Uso: $0 <vmid1> [vmid2] [vmid3] ..."
    echo "Ejemplo: $0 100 101 102"
    exit 1
fi

VMIDS=("$@")

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "=========================================="
echo "Renovando DHCP en ${#VMIDS[@]} VMs..."
echo "=========================================="

for VMID in "${VMIDS[@]}"; do
    echo -e "\n${YELLOW}[*]${NC} Procesando VM: $VMID"
    
    # Verificar que la VM existe y está corriendo
    if ! qm status $VMID >/dev/null 2>&1; then
        echo -e "${RED}[✗]${NC} VM $VMID no existe"
        continue
    fi
    
    STATUS=$(qm status $VMID | awk '{print $2}')
    if [ "$STATUS" != "running" ]; then
        echo -e "${RED}[✗]${NC} VM $VMID no está corriendo (status: $STATUS)"
        continue
    fi
    
    # Verificar que qemu-guest-agent está disponible
    if ! qm guest cmd $VMID ping >/dev/null 2>&1; then
        echo -e "${RED}[✗]${NC} qemu-guest-agent no responde en VM $VMID"
        continue
    fi
    
    echo -e "${GREEN}[✓]${NC} qemu-guest-agent activo"
    
    # Obtener la interfaz de red principal (la que tiene gateway)
    INTERFACE=$(qm guest exec $VMID -- ip route show default 2>/dev/null | grep -oP 'dev \K\S+' | head -n1)
    
    if [ -z "$INTERFACE" ]; then
        echo -e "${RED}[✗]${NC} No se pudo detectar la interfaz de red"
        continue
    fi
    
    echo -e "${YELLOW}[*]${NC} Interfaz detectada: $INTERFACE"
    
    # Release DHCP
    echo -e "${YELLOW}[*]${NC} Liberando IP..."
    if qm guest exec $VMID -- dhclient -r $INTERFACE 2>/dev/null; then
        echo -e "${GREEN}[✓]${NC} IP liberada"
    else
        echo -e "${YELLOW}[!]${NC} No se pudo liberar IP (puede ser normal)"
    fi
    
    sleep 1
    
    # Renew DHCP
    echo -e "${YELLOW}[*]${NC} Renovando IP..."
    if qm guest exec $VMID -- dhclient $INTERFACE 2>/dev/null; then
        echo -e "${GREEN}[✓]${NC} DHCP renovado exitosamente"
        
        # Mostrar la nueva IP
        sleep 2
        NEW_IP=$(qm guest exec $VMID -- ip -4 addr show $INTERFACE 2>/dev/null | grep -oP 'inet \K[\d.]+' | head -n1)
        if [ -n "$NEW_IP" ]; then
            echo -e "${GREEN}[✓]${NC} Nueva IP: $NEW_IP"
        fi
    else
        echo -e "${RED}[✗]${NC} Error al renovar DHCP"
    fi
done

echo -e "\n=========================================="
echo "Proceso completado"
echo "=========================================="

