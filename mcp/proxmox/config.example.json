{
    "proxmox": {
        "host": "192.168.136.238",
        "port": 8006,
        "verify_ssl": true,
        "service": "PVE"
    },
    "auth": {
        "user": "root@pam",
        "token_name": "mcp-token",
        "token_value": "<TOKEN_SECRET>"
    },
    "logging": {
        "level": "INFO",
        "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
        "file": "<MCP_DIR>/proxmox_mcp.log"
    },
    "mcp": {
        "transport": "STDIO"
    },
    "security": {
        "dev_mode": false
    },
    "jobs": {
        "sqlite_path": "<MCP_DIR>/proxmox-jobs.sqlite3"
    },
    "command_policy": {
        "mode": "deny_all",
        "allow_patterns": [],
        "deny_patterns": [
            "(^|\\s)rm\\s+-rf(\\s|$)",
            ":\\(\\)\\{:\\|:\\&\\};:"
        ],
        "require_approval_token": false,
        "approval_token": null
    }
}
