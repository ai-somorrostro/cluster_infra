[Unit]
Description=Expire Proxmox Cloud-Init GUI user password on first boot
# Do not use WantedBy=multi-user.target: After=cloud-final.service creates an
# ordering cycle on Ubuntu (systemd deletes the start job; service never runs).
Wants=cloud-final.service
After=cloud-final.service
ConditionPathExists=!/var/lib/iab-expire-cloudinit-password.done

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/iab-expire-cloudinit-password

[Install]
WantedBy=cloud-final.service
